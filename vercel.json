{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/verify-pass.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/verify-pass",
      "destination": "/api/verify-pass"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...endpoint]"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/$1"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!api|admin).*)",
      "destination": "/public/$1"
    }
  ]
}
