{
  "version": 2,
  "rewrites": [
    { 
      "source": "/api/(.*)", 
      "destination": "/api/$1" 
    },
    { 
      "source": "/admin", 
      "destination": "/admin/index.html" 
    },
    { 
      "source": "/admin/(.*)", 
      "destination": "/admin/$1" 
    },
    { 
      "source": "/((?!api/|admin/|public/|style-ui.css|js/|features/).*)", 
      "destination": "/index.html" 
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" }
      ]
    }
  ]
}
