{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/$1"
    },
    {
      "source": "/((?!api|admin).*)",
      "destination": "/$1"
    }
  ]
}
